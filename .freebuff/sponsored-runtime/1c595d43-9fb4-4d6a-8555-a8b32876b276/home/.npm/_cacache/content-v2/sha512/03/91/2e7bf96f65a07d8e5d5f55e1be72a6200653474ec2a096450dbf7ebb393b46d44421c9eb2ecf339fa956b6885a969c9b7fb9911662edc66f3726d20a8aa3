.1","mocha":"^10.2.0"},"scripts":{"build":"./build.sh","test":"mocha"},"types":"./dist/index.d.ts","gitHead":"074f06bb6c5983e5820c2943ab2d4abf15a0402b","bugs":{"url":"https://github.com/tyleraldrich/hcl2-parser/issues"},"homepage":"https://github.com/tyleraldrich/hcl2-parser#readme","_id":"hcl2-json-parser@1.0.1","_nodeVersion":"18.17.0","_npmVersion":"9.6.7","dist":{"integrity":"sha512-YLV2yfQfCyo91UvHOoiYVZZBsPlvQzPIyHNiATtKFLsEkQ7FYQ8Gn0uMtt1eDg2H9qLy3n9X77wv/XbCX89q1Q==","shasum":"a3aee9ac8ea1e0ef5620fabb29881edeb034111b","tarball":"https://registry.npmjs.org/hcl2-json-parser/-/hcl2-json-parser-1.0.1.tgz","fileCount":14,"unpackedSize":4166289,"signatures":[{"keyid":"SHA256:jl3bwswu80PjjokCgh0o2w5c2U4LhQAE57gj9cz1kzA","sig":"MEUCIQD2N+qrpCePR9w88vzOCHe1+p15wvs/eCxXFQrLvOra0QIgD8+1w9DqgxYcNfl4HCFOosR7CzN9TGloSS73H5oQwCs="}]},"_npmUser":{"name":"tyleraldrich","email":"tyler@tyleraldrich.cat"},"directories":{},"maintainers":[{"name":"tyleraldrich","email":"tyler@tyleraldrich.cat"}],"_npmOperationalInternal":{"host":"s3://npm-registry-packages","tmp":"tmp/hcl2-json-parser_1.0.1_1697828033186_0.5128805025202188"},"_hasShrinkwrap":false}},"time":{"created":"2023-10-20T18:51:42.382Z","1.0.0":"2023-10-20T18:51:42.676Z","modified":"2023-10-20T18:53:53.630Z","1.0.1":"2023-10-20T18:53:53.456Z"},"maintainers":[{"name":"tyleraldrich","email":"tyler@tyleraldrich.cat"}],"description":"HCL v2 parser for JavaScript","homepage":"https://github.com/tyleraldrich/hcl2-parser#readme","keywords":["terraform","hcl","json"],"repository":{"url":"git+https://github.com/tyleraldrich/hcl2-parser.git","type":"git"},"author":{"name":"Tyler Aldrich"},"bugs":{"url":"https://github.com/tyleraldrich/hcl2-parser/issues"},"license":"MIT","readme":"# HCL v2 parser for JS\n\nThis is a [HCL version 2](https://pkg.go.dev/github.com/hashicorp/hcl/v2#readme-changes-in-2-0) parser for JavaScript, there are several other JS parsers for HCL but none that support the newer HCL v2 syntax.\n\nIt wraps the very helpful [tmccombs/hcl2json](https://github.com/tmccombs/hcl2json) and calls the convert package in order to parse HCL input strings to JSON strings. The Go code in `parser.go` is converted to JS using [GopherJS](https://github.com/gopherjs/gopherjs)\n\nThis is an updated version of [hcl2-parser](https://www.npmjs.com/package/hcl2-parser). The original library is no longer maintained, and did not return errors to the user. This version returns a Promise that is rejected when an error (e.g. a syntax error) is returned while parsing.\n\nTypeScript definitions are included\n\n## Reference\n\nThe module exports the following functions:\n\n```ts\n// Returns the parsed JSON String, or rejects with the error.\nfunction parseToString(input: string): Promise<string>\n// Returns the parsed JSON string converted to an object with JSON.parse(),\n// or rejects with the error.\nfunction parseToObject(input: string): Promise<AnyJson>\n```\n\n## Usage\n\nInstall as normal with NPM\n\n```bash\nnpm install hcl2-json-parser\n```\n\nImporting into your project\n\n```ts\n// Good old fashioned Node.js CommonJS require\nconst hcl = require(\"hcl2-json-parser\")\n\n// Import with ES6 or TypeScript\nimport * as hcl = from \"hcl2-json-parser\"\n```\n\nSimple example of usage\n\n```js\nconst hcl = require(\"hcl2-json-parser\")\n\nconst hclString = `\n# Create a resource group\nvariable \"azureRegion\" {\n  type = string\n  default = \"uksouth\"\n}\nresource \"azurerm_resource_group\" \"example\" {\n  name     = \"example-resources\"\n  location = var.azureRegion\n}\n`\n\n// Parse into a JSON string\nstringResult = await hcl.parseToString(hclString)\nconsole.log(stringResult)\n\n// Parse into an object\nobjectResult = await hcl.parseToObject(hclString)\nconsole.log(objectResult.resource.azurerm_resource_group)\n\ntry {\n  result = await hcl.parseToObject(\"invalid hcl!!!\");\n} catch (e) {\n  // `e` will contain the error thrown by the underlying github.com/tmccombs/hcl2json library.\n}\n```\n","readmeFilename":"README.md"}