# Backend port. NOTE: the local sandbox exports PORT=0, and server.js uses
# override:true so this value wins. Port 5000 may be taken by another app.
PORT=3001
MONGODB_URI=mongodb://localhost:27017/time-management
JWT_SECRET=generate-a-long-random-string

# Exa web search (server-side only - never expose this to the browser).
# Create a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=
