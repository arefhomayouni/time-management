# Backend port. NOTE: the sandbox exports PORT=0 as a placeholder; env.js treats
# 0 as "unset" so this value wins. Port 5000 may be taken by another app.
PORT=3001
MONGODB_URI=mongodb://localhost:27017/time-management
JWT_SECRET=generate-a-long-random-string

# Browser origins allowed to call the API, comma-separated and without a
# trailing slash, e.g. https://app.example.com,https://www.example.com
# Leave empty in development: any origin is allowed (that is what makes a
# phone testing against http://192.168.x.x:3001 work). Set it in production.
CORS_ORIGINS=

# Exa web search (server-side only - never expose this to the browser).
# Create a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=
